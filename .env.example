# انسخ هذا الملف إلى .env.local واملأ القيم الفعلية — لا تُرفع .env.local إلى Git.
# مرجع كل متغير: SPEC.md §17 (هيكل المشروع ومتغيرات البيئة)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# خادم فقط — ممنوع استيراده في أي ملف "use client" (راجع CLAUDE.md → قواعد أمنية حرجة)
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (VAPID) — SPEC.md §9. تُولَّد مرة واحدة بـ: npx web-push generate-vapid-keys
# المفتاح العام لازم NEXT_PUBLIC_ لأن المتصفح يحتاجه عند الاشتراك (PushManager.subscribe)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ملح تجزئة بصمة الزائر لتحديد المعدل بلا تخزين IP خام — SPEC.md §10/§13.1
DAILY_HASH_SALT=

# سر يحمي app/api/internal/dispatch-notifications من الاستدعاء العام.
# الاسم CRON_SECRET إلزامي حرفيًا — Vercel يتعرَّف على متغيّر بهذا الاسم تحديدًا
# ويُرسله تلقائيًا كرأس "Authorization: Bearer <CRON_SECRET>" مع كل استدعاء
# Cron مُعرَّف في vercel.json، بلا أي إعداد إضافي.
CRON_SECRET=

# رقم واتساب المنصة (E.164، مثال: +201xxxxxxxxx) لاستقبال طلبات شراء مكتبة
# النماذج القانونية (SPEC.md §8/F7) — التسليم يدوي في هذا الإصدار.
NEXT_PUBLIC_FORMS_WHATSAPP_NUMBER=
